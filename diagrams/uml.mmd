
classDiagram
    class Owner {
        +name: str
        +preferences: dict
        +pets: list
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +name: str
        +species: str
        +tasks: list
        +add_task(task)
        +get_tasks()
    }

    class Task {
        +description: str
        +time: str
        +duration: int
        +priority: str
        +frequency: str
        +completed: bool
        +mark_complete()
    }

    class Scheduler {
        +sort_by_time(tasks)
        +filter_tasks(tasks)
        +detect_conflicts(tasks)
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : retrieves tasks

  
